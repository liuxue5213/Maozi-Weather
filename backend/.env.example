# 应用配置
APP_NAME=毛仔天气
APP_ENV=development
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=60245
APP_V1_PREFIX=/api

# 密钥（生产环境务必修改）
SECRET_KEY=your-secret-key-change-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# MySQL
DB_HOST=localhost
DB_PORT=60241
DB_USER=maozi
DB_PASSWORD=maozi123
DB_NAME=maozi_weather
DB_ECHO=false

# Redis
REDIS_HOST=localhost
REDIS_PORT=60242
REDIS_PASSWORD=
REDIS_DB=0

# CMA 气象数据网（生产环境请填入真实值）
CMA_APPID=your_cma_appid
CMA_APPSECRET=your_cma_appsecret
CMA_BASE_URL=http://data.cma.cn/api

# CMA 限流配置
CMA_QPS_LIMIT=10
CMA_MAX_RETRIES=3
CMA_RETRY_DELAY=2

# 和风天气 (QWeather) - Ed25519 JWT 认证
# 注册地址: https://dev.qweather.com
QWEATHER_CRED_ID=your_credential_id        # 凭据ID（如 T4B99P5557）
QWEATHER_USER_ID=your_user_id              # User ID（如 46E5G85Q4G）
QWEATHER_API_HOST=your_api_host            # 自定义API Host（如 ng6yw3hg4y.re.qweatherapi.com）
QWEATHER_PRIVATE_KEY_PATH=path_to_private_key  # Ed25519 私钥文件路径

# 数据源配置
WEATHER_PRIMARY_SOURCE=open_meteo
WEATHER_FALLBACK_ENABLED=true

# 日志
LOG_LEVEL=INFO
